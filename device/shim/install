#!/bin/sh
# A stand-in for install(1), which the tablet does not have (no coreutils,
# and its busybox has no install applet). Covers what our install scripts use:
#   install -d [-m MODE] DIR...
#   install [-m MODE] SRC... DEST     (DEST a directory, or one SRC to a file)
set -e
mode="" dirs=""
while [ $# -gt 0 ]; do
    case $1 in
    -d) dirs=1; shift ;;
    -m) mode=$2; shift 2 ;;
    -m*) mode=${1#-m}; shift ;;
    --) shift; break ;;
    -*) echo "install shim: unsupported option $1" >&2; exit 2 ;;
    *) break ;;
    esac
done
if [ -n "$dirs" ]; then
    mkdir -p "$@"
    [ -z "$mode" ] || chmod "$mode" "$@"
    exit 0
fi
[ $# -ge 2 ] || { echo "install shim: need SRC and DEST" >&2; exit 2; }
for dest; do :; done
n=$(($# - 1))
while [ "$n" -gt 0 ]; do
    src=$1; shift; n=$((n - 1))
    if [ -d "$dest" ]; then out="$dest/$(basename "$src")"; else out=$dest; fi
    cp "$src" "$out.install-tmp"
    [ -z "$mode" ] || chmod "$mode" "$out.install-tmp"
    mv -f "$out.install-tmp" "$out"
done
