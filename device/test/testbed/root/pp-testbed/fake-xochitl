#!/bin/sh
# Stand-in for xochitl in the test bed: stays up and pets the stock unit's
# 60 s watchdog. Touch /home/root/pp-testbed-crash-xochitl to make it crash
# right away instead (for boot-loop tests).
if [ -e /home/root/pp-testbed-crash-xochitl ]; then sleep 2; exit 1; fi
while :; do
    systemd-notify WATCHDOG=1
    sleep 20
done
