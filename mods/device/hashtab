#!/bin/bash
# Build qt-resource-rebuilder's hashtab for the xochitl on this device.
# Same steps as upstream's xovi/rebuild_hashtable, minus the prompts:
# run xochitl once under xovi with only qt-resource-rebuilder loaded and
# QMLDIFF_HASHTAB_CREATE set, wait for "[qmldiff]: Hashtab saved to", stop it.
#   /home/root/xovi/paper-pure/hashtab [--force] [--timeout SECONDS]
# Skips the run when hashtab.key says the hashtab was built from this exact
# xochitl and qt-resource-rebuilder. Always brings the stock UI back at the end.
set -uo pipefail
xovi=/home/root/xovi
qrr_so=$xovi/extensions.d/qt-resource-rebuilder.so
dir=$xovi/exthome/qt-resource-rebuilder
force=0 timeout=600
while [ $# -gt 0 ]; do
    case $1 in
    --force) force=1 ;;
    --timeout) timeout=$2; shift ;;
    *) echo "usage: hashtab [--force] [--timeout SECONDS]" >&2; exit 2 ;;
    esac
    shift
done
[ -f "$qrr_so" ] || { echo "hashtab: $qrr_so missing" >&2; exit 1; }

key="xochitl $(sha256sum /usr/bin/xochitl | cut -d' ' -f1) qrr $(sha256sum "$qrr_so" | cut -d' ' -f1)"
if [ "$force" = 0 ] && [ -s "$dir/hashtab" ] && [ "$(cat "$dir/hashtab.key" 2>/dev/null)" = "$key" ]; then
    echo "hashtab: up to date ($dir/hashtab)"
    exit 0
fi

root=/tmp/xovi-hashtab log=/tmp/xovi-hashtab.log
cleanup() {
    [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null
    rm -rf "$root"
    systemctl start xochitl   # never leave the tablet without a UI
}
trap cleanup EXIT

echo "hashtab: building for $(sed -n 's/^IMG_VERSION=//p' /etc/os-release | tr -d '"'), up to ${timeout}s"
systemctl stop xochitl
while pidof xochitl >/dev/null; do sleep 0.5; done
rm -rf "$root"; mkdir -p "$root/extensions.d" "$dir"
ln -s "$qrr_so" "$root/extensions.d/"
rm -f "$dir/hashtab" "$dir/hashtab.key"

XOVI_ROOT=$root QMLDIFF_HASHTAB_CREATE=$dir/hashtab QML_DISABLE_DISK_CACHE=1 \
    LD_PRELOAD=$xovi/xovi.so /usr/bin/xochitl --system > "$log" 2>&1 &
pid=$!
start=$(date +%s)
while ! grep -q "Hashtab saved to $dir/hashtab" "$log"; do
    if ! kill -0 "$pid" 2>/dev/null; then echo "hashtab: xochitl exited early, see $log" >&2; tail -n 20 "$log" >&2; exit 1; fi
    if [ $(( $(date +%s) - start )) -ge "$timeout" ]; then echo "hashtab: timed out after ${timeout}s, see $log" >&2; exit 1; fi
    sleep 1
done
kill "$pid"; wait "$pid" 2>/dev/null; pid=
echo "$key" > "$dir/hashtab.key"
echo "hashtab: saved $dir/hashtab ($(wc -c < "$dir/hashtab") bytes, sha256 $(sha256sum "$dir/hashtab" | cut -d' ' -f1)) in $(( $(date +%s) - start ))s"
